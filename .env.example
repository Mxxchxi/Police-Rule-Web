# Public Convex URL used by the React client.
# Example: https://your-deployment.convex.cloud
VITE_CONVEX_URL=

# Convex Auth site URL. This must be the URL that serves the Convex HTTP auth routes.
# For local development, Convex normally provides a *.convex.site URL.
CONVEX_SITE_URL=

# Development deployment selected by `npx convex dev`.
# Example: dev:your-deployment-name
CONVEX_DEPLOYMENT=

# Freebuff federated auth issuer. Leave as https://freebuff.com unless your deployment uses another issuer.
VLY_CONVEX_AUTH_ISSUER=https://freebuff.com

# Optional application name used in OTP emails.
VLY_APP_NAME=Police Rule Web

# Required by the Freebuff OTP sender.
# Set this in Convex/Vercel environment variables; do not commit the real key.
FREEBUFF_EMAIL_API_KEY=
