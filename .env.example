# ============================================================
# Frontend / Convex environment
# ============================================================
# Development: run `npx convex dev` and use the URL it provides.
# Production: set these values in the hosting provider's environment.

# Client-side Convex deployment URL used by ConvexReactClient.
VITE_CONVEX_URL=

# Convex Site URL used as the issuer for Convex Auth.
# Development example: http://localhost:5173
# Production: use the SITE URL of the deployed Convex backend,
# not the URL of the frontend hosting provider.
CONVEX_SITE_URL=http://localhost:5173

# Deployment used by `npx convex dev` / `npx convex deploy`.
# Do not commit a real deployment key or secret to this file.
CONVEX_DEPLOYMENT=

# Optional: Freebuff federated authentication issuer.
# Leave unset to use the default issuer configured in auth.config.ts.
VLY_CONVEX_AUTH_ISSUER=
